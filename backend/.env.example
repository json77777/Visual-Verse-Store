PORT=8000

NODE_ENV=production

# MongoDB connection string (Atlas recommended)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/<dbname>
CORS_ORIGIN=https://your-frontend-domain.vercel.app

# JWT secrets
ACCESS_TOKEN_SECRET=your_access_token_secret
REFRESH_TOKEN_SECRET=your_refresh_token_secret

# Cloudinary (for image/file uploads)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Razorpay (payments)
RAZORPAY_KEY_ID=rzp_test_...
RAZORPAY_KEY_SECRET=...
RAZORPAY_WEBHOOK_SECRET=...

# SendGrid / Email
SENDGRID_API_KEY=SG.xxxxx
EMAIL_FROM="Your Store <no-reply@yourdomain.com>"
SUPPORT_EMAIL=support@yourdomain.com
ADMIN_NOTIFICATION_EMAIL=admin@yourdomain.com

# App URL (frontend)
APP_URL=https://your-frontend-domain.vercel.app



# Backend environment variables (example)

PORT=8000
NODE_ENV=development

# Allow the Next.js dev server origin for cookie-based auth
# If you have multiple origins, separate them with commas.
CORS_ORIGIN=http://localhost:3000

# Database
MONGODB_URI=mongodb://127.0.0.1:27017/visual-verse

# JWT
ACCESS_TOKEN_SECRET=change-me
ACCESS_TOKEN_EXPIRY=1d
REFRESH_TOKEN_SECRET=change-me
REFRESH_TOKEN_EXPIRY=7d

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
